generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AuthProvider {
  GOOGLE
  GITHUB
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String?

  oauthAccounts OAuthAccount[]

  repositories Repository[]
  scans        Scan[]
  messages     ChatMessage[]
  chatSessions ChatSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthAccount {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OAuthState {
  id           String       @id @default(uuid())
  state        String       @unique
  codeVerifier String
  provider     AuthProvider
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  @@index([expiresAt])
}

model Repository {
  id            String    @id @default(uuid())
  userId        String
  name          String
  fullName      String
  githubUrl     String
  defaultBranch String    @default("main")
  lastScannedAt DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans Scan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fullName])
  @@index([userId])
}

model ChatSession {
  id     String @id @default(uuid())
  userId String
  title  String @default("New Analysis")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  scans    Scan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model Scan {
  id            String  @id @default(uuid())
  userId        String
  repositoryId  String
  chatSessionId String?

  status      ScanStatus @default(PENDING)
  totalIssues Int        @default(0)
  critical    Int        @default(0)
  high        Int        @default(0)
  medium      Int        @default(0)
  low         Int        @default(0)

  architecture      Json?
  architectureGraph Json?
  aiAnalysis        Json?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository  Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  chatSession ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  findings Finding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([repositoryId])
  @@index([chatSessionId])
}

model Finding {
  id             String   @id @default(uuid())
  scanId         String
  title          String
  description    String
  recommendation String
  severity       Severity
  filePath       String?
  lineNumber     Int?
  isResolved     Boolean  @default(false)

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scanId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  sessionId String?
  scanId    String?
  role      ChatRole
  content   String

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}
